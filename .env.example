# Copy to .env.local (gitignored). Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Web: reCAPTCHA v3 site key. Extension: debug token only.
VITE_RECAPTCHA_SITE_KEY=
# "true" to have the SDK print a new debug token in the console (then register it in
# Firebase console → App Check → Apps → Manage debug tokens and paste it here instead).
VITE_APPCHECK_DEBUG_TOKEN=true

# Optional cloud model override (default: gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=
